{
  "commands": {
    "generate": {
      "aliases": [],
      "args": {
        "name": {
          "description": "Directory name of new project.",
          "name": "name",
          "required": true
        }
      },
      "description": "This will generate a fully functional oclif CLI that you can build on. It will prompt you for all the necessary information to get started. If you want to skip the prompts, you can pass the --yes flag to accept the defaults for all prompts. You can also pass individual flags to set specific values for prompts.\n\nHead to oclif.io/docs/introduction to learn more about building CLIs with oclif.",
      "examples": [
        {
          "command": "<%= config.bin %> <%= command.id %> my-cli",
          "description": "Generate a new CLI with prompts for all properties"
        },
        {
          "command": "<%= config.bin %> <%= command.id %> my-cli --yes",
          "description": "Automatically accept default values for all prompts"
        },
        {
          "command": "<%= config.bin %> <%= command.id %> my-cli --module-type CommonJS --author \"John Doe\"",
          "description": "Supply answers for specific prompts"
        },
        {
          "command": "<%= config.bin %> <%= command.id %> my-cli --module-type CommonJS --author \"John Doe\" --yes",
          "description": "Supply answers for specific prompts and accept default values for the rest"
        }
      ],
      "flags": {
        "author": {
          "description": "Supply answer for prompt: Author",
          "name": "author",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "bin": {
          "description": "Supply answer for prompt: Command bin name the CLI will export",
          "name": "bin",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "description": {
          "description": "Supply answer for prompt: Description",
          "name": "description",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "license": {
          "description": "Supply answer for prompt: License",
          "name": "license",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "module-type": {
          "description": "Supply answer for prompt: Select a module type",
          "name": "module-type",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "CommonJS",
            "ESM"
          ],
          "type": "option"
        },
        "name": {
          "description": "Supply answer for prompt: NPM package name",
          "name": "name",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "owner": {
          "description": "Supply answer for prompt: Who is the GitHub owner of repository (https://github.com/OWNER/repo)",
          "name": "owner",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
